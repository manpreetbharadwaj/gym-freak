.expo/
dist/
web-build/
*.tsbuildinfo
.metro-health-check*

# Native projects are committed: they carry hand-made changes (launch screen, icons, entitlements,
# Info.plist, MainActivity) that `npx expo prebuild` would not reproduce. Only their build output is ignored.
/ios/Pods/
/ios/build/
/ios/.xcode.env.local
**/xcuserdata/
*.xcuserstate
/android/.gradle/
/android/build/
/android/app/build/
/android/app/.cxx/
/android/local.properties
/android/.kotlin/

