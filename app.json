{
  "expo": {
    "name": "Gym Freak",
    "slug": "gym-freak",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "gymfreak",
    "backgroundColor": "#F3F0FF",
    "primaryColor": "#5A3BFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymfreak.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "location"
        ]
      },
      "associatedDomains": [
        "applinks:gymfreak.app"
      ]
    },
    "android": {
      "package": "com.gymfreak.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/app_logo.png",
        "backgroundColor": "#0E0E10"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.WRITE_ACTIVE_CALORIES_BURNED",
        "android.permission.health.WRITE_DISTANCE",
        "android.permission.health.WRITE_EXERCISE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "gymfreak.app",
              "pathPrefix": "/exercise"
            },
            {
              "scheme": "https",
              "host": "gymfreak.app",
              "pathPrefix": "/ref"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#5A3BFF",
          "sounds": [
            "./src/assets/sound/waterdrop.wav"
          ]
        }
      ],
      "expo-localization",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#02060B",
          "image": "./src/assets/app_logo.png",
          "imageWidth": 176,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Gym Freak uses your location only while you record a run, walk, hike or trek, to draw your route and measure distance and pace.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Gym Freak only uses your location while you record a run, walk, hike or trek that you started. It never tracks you otherwise.",
          "locationAlwaysPermission": "Gym Freak only uses your location while you record a run, walk, hike or trek that you started. It never tracks you otherwise."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Gym Freak reads your steps, walking and running distance, active energy and workouts (including ones recorded on Apple Watch) to complete your Activity dashboard, history and streaks, and, only if you choose to import them, body fat readings for Body composition.",
          "NSHealthUpdateUsageDescription": "Gym Freak saves the runs, walks, hikes and yoga sessions you record in the app to Apple Health, if you turn this on.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-iap",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gym Freak lets you attach screenshots to support requests and feedback. Only the photos you choose are shared.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Gym Freak accesses only the fitness share images you choose to save.",
          "savePhotosPermission": "Gym Freak saves a fitness share image only when you tap Save Image.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "splash": {
      "image": "./src/assets/app_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#02060B"
    },
    "extra": {
      "supportsRTL": true
    },
    "icon": "./src/assets/app_logo.png"
  }
}
