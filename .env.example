# Copy to .env.local (git-ignored) and adjust.
# api = talk to the shared HealthyMe backend; anything else = offline mock data.
EXPO_PUBLIC_GYM_DATA_MODE=api
# Base URL of healthyMe-Backend (no /v1). Simulators: your Mac's LAN IP; Android emulator may also use http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://192.168.1.17:3000
# Public link domain for shared exercises / invites (universal links + Android App Links).
# Must match PUBLIC_WEB_URL on the backend and the domain in app.json / native link config.
EXPO_PUBLIC_LINK_BASE_URL=https://gymfreak.app
# Optional: Google Maps key for map tiles on Android (react-native-maps). Without it Android draws the
# GPS route without map tiles; iOS uses Apple Maps and needs no key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Debug builds only: price the paywall as this storefront (ISO alpha-2 or alpha-3, e.g. GB) for QA on simulators,
# whose StoreKit storefront can only be changed from Xcode. Ignored in release builds.
# EXPO_PUBLIC_DEV_STOREFRONT=GB
